  </table>
<br>

   <table border="1" cellpadding="10" cellspacing="0">
      <tr>
        <th>Student</th>
        <th>Age</th>
        <th>Course</th>
    </tr>
    <tr>
        <td>Raj</td>
        <td>21</td>
